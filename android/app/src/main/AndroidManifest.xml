<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional hardware: app runs on devices without these -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            Receives the ongoing-call notification's Hang up action and relays it to
            the Jitsi SDK. Not exported: the only sender is this app's own
            notification, and letting other apps end calls would be a gift.
        -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!--
            Push notification presentation.

            While the app is backgrounded or dead, the notification is built by
            the Firebase SDK from the server's `notification` block, not by any
            code in this app — so these three values are the only control over
            how it looks, and without them Firebase logs a warning and falls
            back to defaults.

            The icon must be a monochrome silhouette with transparency: Android
            masks the small icon to its alpha channel, so the launcher icon used
            as a fallback renders as a solid white square. ic_notification.png
            already shipped in five density buckets but nothing referenced it,
            which is exactly the square-blob case.

            default_notification_channel_id is the fallback for a push whose
            named channel does not exist on the device. That is a real path, not
            a theoretical one: the channels are otherwise created by JavaScript
            at sign-in, so a push arriving before the web layer has ever run —
            first launch, or after the user clears app data — names a channel
            Android does not know and is dropped without a trace. PushChannels
            also creates them natively at startup to close the same gap.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationAccent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_messages" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone / WebRTC / getUserMedia({ audio: true }) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera / video calls / capture file inputs -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Geolocation (Capacitor BridgeWebChromeClient requests these at runtime) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- File access: legacy storage + WebView file picker / downloads -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Bluetooth audio devices (headsets / speakers) with WebRTC on Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Push notifications. Runtime-requestable from Android 13 (API 33) on, which
        is why the web layer prompts for it rather than assuming the grant.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        In-app updates. The app is distributed outside Play, so upgrading means
        downloading an APK and handing it to the system installer. Android has no
        silent path for this by design: the user still confirms in the installer
        UI, and on Android 8+ they must also grant "install unknown apps" to this
        app once.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
