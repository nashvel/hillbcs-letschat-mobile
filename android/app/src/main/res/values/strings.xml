<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Let\'s Chat</string>
    <string name="title_activity_main">Let\'s Chat</string>
    <string name="package_name">com.hillbcs.letschat</string>
    <string name="custom_url_scheme">com.hillbcs.letschat</string>

    <!--
        Overrides the Jitsi SDK's own wording for the ongoing-call notification,
        the same way drawable/ic_notification overrides its icon: an app resource
        of the same name wins over a library's during merge.

        Static by necessity. OngoingNotification reads these through getString()
        with no arguments and its builder takes only (isMuted, context, class), so
        there is no per-call value to pass — the conversation name cannot appear
        here. It goes in the call UI header via setSubject() instead. The same
        limitation rules out an avatar: that notification never calls
        setLargeIcon, so it has no image slot beyond the monochrome small icon.
    -->
    <string name="ongoing_notification_title">Let\'s Chat</string>
    <string name="ongoing_notification_text">Call in progress. Tap to return.</string>

    <!--
        Notification channels for push. The ids are a contract with the server:
        FirebasePushService puts one of them in android.notification.channel_id
        on every message it sends, and Android silently discards a notification
        naming a channel that does not exist. They are also created from
        JavaScript by nativePush.ts; all three places must agree.

        Declared here so PushChannels and the manifest's
        default_notification_channel_id cannot drift apart from each other.
    -->
    <string name="push_channel_messages">hillbcs_chat_messages</string>
    <string name="push_channel_calls">hillbcs_chat_calls</string>
    <string name="push_channel_messages_name">Chat messages</string>
    <string name="push_channel_messages_description">New messages, mentions, and chat updates</string>
    <string name="push_channel_calls_name">Calls</string>
    <string name="push_channel_calls_description">Incoming voice and video calls</string>
</resources>
